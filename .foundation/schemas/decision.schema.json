{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision entry front matter",
  "type": "object",
  "required": ["id", "title", "status", "date"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^D-[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["open", "current", "superseded"]},
    "date": {"format": "date"},
    "superseded_by": {"type": "string", "pattern": "^D-[0-9]{3,}$"}
  }
}
